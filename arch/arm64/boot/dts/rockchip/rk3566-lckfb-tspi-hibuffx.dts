			// 第三组寄存器配置 (E0=0x02)
			15 00 02 E0 02 // {0xE0, 1, { 0x02}}
			15 00 02 00 42 // {0x00, 1, { 0x42}}
			15 00 02 01 42 // {0x01, 1, { 0x42}}
