            15 05 02 29 00
        ];

        panel-exit-sequence = [
            05 00 01 28
            05 00 01 10
        ];

        disp_timings1: display-timings {
            native-mode = <&dsi1_timing0>;
            dsi1_timing0: timing0 {
                clock-frequency = <67000000>;
                hactive = <800>;
                hfront-porch = <18>;
                hback-porch = <18>;
                hsync-len = <18>;
                vactive = <1280>;
                vfront-porch = <20>;
                vback-porch = <10>;
                vsync-len = <4>;
                hsync-active = <0>;
                vsync-active = <0>;
                de-active = <0>;
                pixelclk-active = <0>;
                swap-rb = <0>;
                swap-rg = <0>;
                swap-gb = <0>;
            };
        };

        ports {
            #address-cells = <1>;
            #size-cells = <0>;

            port@0 {
                reg = <0>;
                panel_in_dsi1: endpoint {
                    remote-endpoint = <&dsi1_out_panel>;
                };
            };
        };
    };
};

/* 激活 DSI PHY */
&dsi_dphy1 {
    status = "okay";
};

&vp1 {
	cursor-win-id = <ROCKCHIP_VOP2_ESMART1>;
};
