			15 00 02 79 15 // {0x79, 1, { 0x15}}
			15 00 02 7A 17 // {0x7A, 1, { 0x17}}
			15 00 02 7D 14 // {0x7D, 1, { 0x14}}
			15 00 02 7E 82 // {0x7E, 1, { 0x82}}

			// E0=0x04配置组
			15 00 02 E0 04 // {0xE0, 1, { 0x04}}
			15 00 02 00 0E // {0x00, 1, { 0x0E}}
			15 00 02 02 B3 // {0x02, 1, { 0xB3}}
			15 00 02 09 61 // {0x09, 1, { 0x61}}
			15 00 02 0E 48 // {0x0E, 1, { 0x48}}

			// E0=0x00配置组
			15 00 02 E0 00 // {0xE0, 1, { 0x00}}

			15 00 02 E6 02 // {0xE6, 1, { 0x02}}
			15 00 02 E7 0C // {0xE7, 1, { 0x0C}}

			// 显示开启命令
			15 78 02 11 00 // {0x11, 1, { 0x00}} 含Delayms(120)
			15 05 02 29 00 // {0x29, 1, { 0x00}} 含Delayms(5)
			//05 00 01 35
		];
        panel-exit-sequence = [
            05 00 01 28
            05 00 01 10
        ];

        disp_timings1: display-timings {
            native-mode = <&dsi1_timing0>;
            dsi1_timing0: timing0 {
                clock-frequency = <67000000>;
                hactive = <800>;
                hfront-porch = <18>;
                hback-porch = <18>;
                hsync-len = <18>;
                vactive = <1280>;
                vfront-porch = <20>;
                vback-porch = <10>;
                vsync-len = <4>;
                hsync-active = <0>;
                vsync-active = <0>;
                de-active = <0>;
                pixelclk-active = <0>;
                swap-rb = <0>;
                swap-rg = <0>;
                swap-gb = <0>;
            };
        };

        /* === 修改重点：简化 Panel 的端口定义 === */
        /* 不要在这里用 ports {} 包裹，直接用 port {} */
        port {
            panel_in_dsi1: endpoint {
                remote-endpoint = <&dsi1_out_panel>;
            };
        };
    };
};

/* 激活 DSI PHY */
&dsi_dphy1 {
    status = "okay";
};

&vp1 {
	cursor-win-id = <ROCKCHIP_VOP2_ESMART1>;
};
